<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/favicon.png') }}">
    {% block mystyles %}
    {% endblock %}

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0-beta1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-0evHe/X+R7YkIZDRvuzKMRqM+OrBnVFBL6DOitfPri4tjfHxaWutUpFmBp4vmVor" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('css/cover.css') }}">
        <link rel="stylesheet" href="{{ asset('css/home_button.css') }}">
        <link rel="stylesheet" href="{{ asset('css/reservation_button.css') }}">
    {% endblock %}
    {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
    {#        {% block stylesheets %}#}
    {#            {{ encore_entry_link_tags('app') }}#}
    {#        {% endblock %}#}

    {% block javascripts %}
        {#            {{ encore_entry_script_tags('app') }}#}
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js" integrity="sha384-aJ21OjlMXNL5UyIl/XNwTMqvzeRMZH2w8c5cRVpzpU8Y5bApTppSuUkhZXN0VxHd" crossorigin="anonymous"></script>
    {% endblock %}

</head>
<body>
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <nav class="navbar">
            <ul class="navbar-nav">
                {% if app.user %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_user') }}">
                        {{ source('svg/user.svg') }}
                        <span class="link-text">{{ app.user.getFirstName() }} {{ app.user.getLastName() }} {% if app.user.isWithPerson() %} +1 {% endif %}</span>
                    </a>
                </li>
                {% endif %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_home') }}">
                        {{ source('svg/home.svg') }}
                        <span class="link-text">Home</span>
                    </a>
                </li>
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_admin_email') }}">
                        {{ source('svg/access.svg') }}
                        <span class="link-text">Dostęp</span>
                    </a>
                </li>
                {% endif %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_information') }}">
                        {{ source('svg/info.svg') }}
                        <span class="link-text">Informacje</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_contact') }}">
                        {{ source('svg/contact.svg') }}
                        <span class="link-text">Kontakt</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_logout') }}">
                        {{ source('svg/log_out.svg') }}
                        <span class="link-text" style="width: 100px">Wyloguj się</span>
                    </a>
                </li>
            </ul>
        </nav>
        {% block body %}{% endblock %}
        <footer class="mt-auto text-white-50">
            <p></p>
        </footer>
    {% endif %}
</body>
</html>
