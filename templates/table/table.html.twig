{% extends 'base.html.twig' %}

{% block title %}Rezerwacja{% endblock %}

{% block body %}
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <link rel="stylesheet" href="{{ asset('css/cover.css') }}">
        <div class="d-flex row-12 v-100 text-center text-white bg-dark">
            <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
                <header class="mb-auto">
                    <div>
                        {% if app.user %}
                            <a style="font-size: 1.17em" href="{{ url('app_user') }}" class="float-md-start mb-0 pt-2 text-decoration-none text-white fw-bold">{{ app.user.getFirstName() }} {{ app.user.getLastName() }} {% if app.user.isWithPerson() %} +1 {% endif %}</a>
                        {% endif %}

                        <nav class="nav nav-masthead justify-content-center float-md-end">
                            <a class="nav-link fw-bold py-1 px-0" aria-current="page" href="{{ url('app_home') }}">Home</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="nav-link fw-bold py-1 px-0" href="{{ url('app_admin_email') }}">Dostęp</a>
                            {% endif %}
                            <a class="nav-link fw-bold py-1 px-0" href="{{ url('app_information') }}">Informacje</a>
                            <a class="nav-link fw-bold py-1 px-0" href="{{ url('app_contact') }}">Kontakt</a>
                            <a class="nav-link fw-bold py-1 px-0" href="{{ path('app_logout') }}">Wyloguj się</a>
                        </nav>
                    </div>
                </header>

                <footer class="mt-auto text-white-50">
                    <p></p>
                </footer>
            </div>

        </div>
        <div class="d-flex align-items-center justify-content-center bg-dark">
            <img src="{{ asset('images/tables.png') }}" class="mb-4 w-50 h-25 rounded-5 img-thumbnail shadow-lg" alt="Sample image">
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <div class="container-fluid bg-dark" ondrop="dropRemoveUserTable(event)"  ondragover="allowDrop(event)">
                <div id="dupa" class="row p-2 text-center">
                    <h2 class="text-white">Użytkownicy bez rezerwacji:</h2>
                {% for user in usersWithoutTable %}
                        <div class="col-auto">
                            <div class="m-1">
                                <div id="{{ user.id }}dupa" draggable="true" ondragstart="drag(event)"  class="list-group-item" style="font-size: 0.8rem; {%if user.isWithPerson() %} background: #202428; color: #ffffff {% else %} background: #ffffff; color: #202428{% endif %}">{{ user.getFirstName }} {{ user.getLastName }} {{ user.email }}</div>
                            </div>
                        </div>
                {% endfor %}
                </div>
            </div>
        {% endif %}

        {% if not is_granted('ROLE_ADMIN')%}
        {% if myUser.getUserTable() %}
            <div class="container-fluid vw-100 text-center text-white bg-success mb-1">
                <div class="p-2">
                    Posiadasz rezerwację{% if myUser.isWithPerson() %} dla dwóch osób {% else %} dla jednej osoby{% endif %}: {{ myUser.getUserTable().getName() }}
                </div>
            </div>
            {% else %}
            <div class="bg-danger container-fluid vw-100 text-center text-white mb-1" style="background: #44CF6C">
                <div class="p-2">
                    Nie posiadasz jeszcze żadnej rezerwacji
                </div>
            </div>
            {% endif %}
        {% endif%}
        <div class="bg-dark container-fluid vw-100">
            {% set i = 0 %}
            {% for table in tables%}
                {% if i % 8 == 0 %}
                    <div class="row">
                {% endif %}
                    <div class="card m-2 p-0 col">
                        <div class="bg-dark text-white list-group-item text-center p-2 m-0" ondrop="drop(event, {{ table.id }})"  ondragover="allowDrop(event)" style="font-size: 0.8rem">{{ table.name }} ({{ table.size }} / 10)</div>
                            <div id="{{ table.id }}" class="list-group list-group-flush text-center h-100" ondrop="drop(event, {{ table.id }})"  ondragover="allowDrop(event)">
                                {% for user in table.getUser|sort|reverse %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <div id="{{ user.id }}dupa" draggable="true" ondragstart="drag(event)"  class="list-group-item" style="font-size: 0.8rem; {%if user.isWithPerson() %} background: #202428; color: #ffffff {% else %} background: #ffffff; color: #202428{% endif %}">{{ user.getFirstName }} {{ user.getLastName }} {{ user.email }}</div>
                                    {% endif %}
                                {% endfor %}
                                {% if myUser.getUserTable.id is defined and myUser.getUserTable.id == table.id and not is_granted('ROLE_ADMIN') %}
                                        <button class="btn btn-danger w-100 border-0 rounded-0 rounded-bottom" onclick="removeReservation({{ table.id }})" style="font-size: 0.8rem; background: #DC0073">Zrezygnuj</button>
                                {% elseif table.size > 0 and not (table.size == 1 and myUser.isWithPerson == 1) and not is_granted('ROLE_ADMIN') %}
                                        <button class="btn btn-success w-100 border-0 rounded-0 rounded-bottom" onclick="makeReservation({{ table.id }})" style="font-size: 0.8rem; background: #44CF6C">Zarezerwuj</button>
                                {% elseif not is_granted('ROLE_ADMIN')%}
                                    Brak miejsc
                                {% endif %}
                            </div>
                    </div>
                {% set i = i + 1 %}
                {% if i % 8 == 0 %}
                    </div>
                {% endif %}
            {% endfor %}

        </div>

    {% endif %}
{% endblock %}

{% block javascripts %}
    <script>

        function getUlChildrenIds(ulId) {
            const parent = document.getElementById(ulId);

            const children = Array.from(parent.children);

            const ids = children.map(element => {
                return element.id;
            });

            ids.shift()

            const values = {
                usersId: ids
            };

            console.log(values);
        }

        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
        }

        function drop(ev, tableId, userId) {
            ev.preventDefault();
            let table = document.getElementById(tableId)
            let data = ev.dataTransfer.getData("text");
            table.appendChild(document.getElementById(data))

            const xhr = new XMLHttpRequest();
            const url = "/admin/table/" + tableId + "/user/" + data.slice(0, -4)
            xhr.open('POST', url)
            xhr.send()
            xhr.onreadystatechange=(e)=>{
                window.location.reload()
            }
        }

        function dropRemoveUserTable(ev) {
            ev.preventDefault();
            let table = document.getElementById("dupa")
            let data = ev.dataTransfer.getData("text");
            table.appendChild(document.getElementById(data))

            const xhr = new XMLHttpRequest();
            const url = "/admin/remove/user/" + data.slice(0, -4)
            xhr.open('POST', url)
            xhr.send()
            xhr.onreadystatechange=(e)=>{
                window.location.reload()
            }
        }

        function makeReservation(tableId) {
            const xhr = new XMLHttpRequest();
            const url = "/user/table/" + tableId
            xhr.open('POST', url)
            xhr.send()
            xhr.onreadystatechange=(e)=>{
                window.location.reload()
            }
        }

        function removeReservation(tableId) {
            const xhr = new XMLHttpRequest();
            const url = "/user/remove/table/" + tableId
            xhr.open('POST', url)
            xhr.send()
            xhr.onreadystatechange=(e)=>{
                window.location.reload()
            }
        }

    </script>
{% endblock %}

