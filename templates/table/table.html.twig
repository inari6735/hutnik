{% extends 'base.html.twig' %}

{% block title %}Strona główna{% endblock %}

{% block body %}
    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <link rel="stylesheet" href="{{ asset('css/cover.css') }}">
        <div class="d-flex row-12 v-100 text-center text-white bg-dark">
            <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
                <header class="mb-auto">
                    <div>
                        {% if app.user %}
                            <a style="font-size: 1.17em" href="{{ url('app_user') }}" class="float-md-start mb-0 pt-2 text-decoration-none text-white fw-bold">{{ app.user.getFirstName() }} {{ app.user.getLastName() }}</a>
                        {% endif %}

                        <nav class="nav nav-masthead justify-content-center float-md-end">
                            <a class="nav-link fw-bold py-1 px-0 active" aria-current="page" href="{{ url('app_home') }}">Home</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="nav-link fw-bold py-1 px-0" href="{{ url('app_admin_email') }}">Dostęp</a>
                            {% endif %}
                            <a class="nav-link fw-bold py-1 px-0" href="#">Informacje</a>
                            <a class="nav-link fw-bold py-1 px-0" href="#">Kontakt</a>
                            <a class="nav-link fw-bold py-1 px-0" href="{{ path('app_logout') }}">Wyloguj się</a>
                        </nav>
                    </div>
                </header>

                <footer class="mt-auto text-white-50">
                    <p></p>
                </footer>
            </div>

        </div>
        <div class="d-flex justify-content-center mt-3">
            <img src="{{ asset('images/tables.png') }}" class="mb-4 w-50 h-25 rounded img-thumbnail shadow-lg"
                 alt="Sample image">
        </div>
        <div class="bg-dark container-fluid vw-100">
            {% set i = 0 %}
            {% for table in tables%}
                {% if i % 8 == 0 %}
                    <div class="row">
                {% endif %}
                    <div class="card m-2 p-0 col">
                        <div class="bg-dark text-white list-group-item text-center p-2 m-0" style="font-size: 0.8rem">{{ table.name }} ({{ table.size }} / 10)</div>
                        <ul id="{{ table.id }}" class="list-group list-group-flush text-center" onclick="getUlChildrenIds({{ table.id }})" ondrop="drop(event)"  ondragover="allowDrop(event)">
                            {% for user in table.getUser|sort|reverse %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li id="{{ user.id }}" draggable="true" ondragstart="drag(event)"  class="text-dark list-group-item" style="font-size: 0.8rem">{{ user.getFirstName }} {{ user.getLastName }} {{ user.email }}</li>
{#                                {% elseif myUser.id == user.id%}#}
{#                                    <li class="text-dark list-group-item" style="font-size: 0.8rem">Twoja rezerwacja</li>#}
{#                                {% else %}#}
{#                                    <li class="text-dark list-group-item" style="font-size: 0.8rem">Zajęte</li>#}
                                {% endif %}
                            {% endfor %}
                            {% if myUser.getUserTable.id is defined and myUser.getUserTable.id == table.id and not is_granted('ROLE_ADMIN') %}
                                <form action="{{ url('app_remove_user_table', {'tableId': table.id}) }}">
                                    <button class="btn btn-danger w-100 border-0 rounded-0 rounded-bottom" style="font-size: 0.8rem; background: #DC0073">Zrezygnuj</button>
                                </form>
                            {% elseif table.size != 0 and not (table.size == 1 and myUser.isWithPerson == 1) and not is_granted('ROLE_ADMIN') %}
                                <form action="{{ url('app_book_table', {'tableId': table.id}) }}">
                                    <button class="btn btn-success w-100 border-0 rounded-0 rounded-bottom" style="font-size: 0.8rem; background: #44CF6C">Zarezerwuj</button>
                                </form>
                            {% endif %}
                        </ul>
                    </div>
                {% set i = i + 1 %}
                {% if i % 8 == 0 %}
                    </div>
                {% endif %}
            {% endfor %}

        </div>


    {% endif %}
{% endblock %}

{% block javascripts %}
    <script>
        const dupa = 1;

        function getUlChildrenIds(ulId) {
            const parent = document.getElementById(ulId);

            const children = Array.from(parent.children);

            const ids = children.map(element => {
                return element.id;
            });

            ids.shift()

            const values = {
                usersId: ids
            };

            console.log(values);
        }

        function allowDrop(ev) {
            ev.preventDefault();
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.target.id);
        }

        function drop(ev) {
            ev.preventDefault();
            let data = ev.dataTransfer.getData("text");
            ev.target.appendChild(document.getElementById(data));
        }
    </script>
{% endblock %}

