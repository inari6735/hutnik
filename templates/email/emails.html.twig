{% extends 'core_base.html.twig' %}

{% block title %}Dostęp{% endblock %}

{% block body %}
    <main class="px-3">
        <table class="table text-white">
            <thead>
                <tr>
                    <td class="pt-5">
                        Email
                    </td>
                </tr>
            </thead>
            <tbody>
            {% for email in emails %}
                <tr>
                    <td class="text-white">
                        {{ email.email }} {% if email.getWithPerson() %}<a class="text-warning text-decoration-none">+1</a>{% endif %}
                        <a class="link-danger text-decoration-none" href="{{ url('app_admin_email_remove', {'emailId': email.id}) }}">-</a>
                    </td>
                </tr>
            {% endfor %}
            <tr>
                <td>
                    <form action="{{ url('app_admin_email_add') }}">
                        <div class="form-floating m-0 text-center">
                            <input placeholder="email" id="floatingInput" class="text-white border-0 form-control" style="background: none; text-align: center" type="text" name="email">
                            <label class="text-center text-white w-100" for="floatingInput">Dodaj nowy email</label>
                        </div>
                    </form>
                </td>
            </tr>
            </tbody>

            <thead class="mt-5">
            <tr>
                <td class="pt-5">
                    Adresy email nieprzypisane do żadnego konta
                </td>
            </tr>
            </thead>
            <tbody>
                {% for unregisteredEmail in unregisteredEmails %}
                    <tr>
                        <td class="text-white">
                            {{ unregisteredEmail.email }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </main>
{% endblock %}
